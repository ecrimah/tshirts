# Mamator — plain Postgres (no Supabase)
# Copy to .env.local and fill in real values before deploy.

# App
NEXT_PUBLIC_APP_URL=https://mamator.com
NEXT_PUBLIC_SITE_NAME=Mamator
NODE_ENV=production

# Database (VPS Postgres)
DATABASE_URL=postgresql://mamator:CHANGE_ME@127.0.0.1:5432/mamator

# Auth (generate with: openssl rand -base64 48)
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_STRING
AUTH_COOKIE_NAME=mamator_session
AUTH_COOKIE_MAX_AGE_DAYS=7

# Uploads on VPS disk (served at /uploads/*)
UPLOAD_DIR=/var/www/mamator/uploads
NEXT_PUBLIC_UPLOAD_BASE_URL=https://mamator.com/uploads

# Email / SMS / payments (keep from previous production env)
ADMIN_EMAIL=
EMAIL_FROM=info@mamator.com
RESEND_API_KEY=
CRON_SECRET=

MOOLRE_ACCOUNT_NUMBER=
MOOLRE_API_PUBKEY=
MOOLRE_API_USER=
MOOLRE_CALLBACK_SECRET=
MOOLRE_SMS_API_KEY=
MOOLRE_SMS_SENDER_ID=

# Optional
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
ADMIN_SMS_NUMBERS=
